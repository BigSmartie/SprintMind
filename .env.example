APP_TITLE=MapleSeed
PAGE_LAYOUT=wide
DEBUG=false

LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
ENABLE_STREAMING=true

ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPUAI_API_KEY=your_zhipu_api_key
ZHIPUAI_VISION_MODEL=glm-4.6v-flash
ZHIPUAI_THINKING_MODE=disabled
ZHIPUAI_TIMEOUT_SECONDS=60

EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_NORMALIZE=true
VECTOR_SIZE=512
ENABLE_EMBEDDING_CACHE=true

ENABLE_RERANKER=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANK_TOP_N=5

QDRANT_PATH=./data/local_qdrant
QDRANT_COLLECTION_NAME=my_agent_db
MEMORY_COLLECTION_NAME=my_memory_db
ENABLE_MULTI_COLLECTION=true

CHUNK_SIZE=500
CHUNK_OVERLAP=50

RETRIEVER_TOP_K=4
ENABLE_MMR=true
MMR_FETCH_K=12
MMR_LAMBDA_MULT=0.5
ENABLE_HYBRID_SEARCH=false
ENABLE_QUERY_REWRITE=true

MAX_FILE_SIZE_MB=200
ENABLE_DOC_DEDUP=true
ENABLE_DOC_UPDATE=true
ENABLE_DOC_DELETE=true
ENABLE_DOC_LIST=true

ENABLE_OCR=true
OCR_ENGINE=rapidocr
OCR_LANGUAGE=ch
ENABLE_IMAGE_EXTRACTION=true
ENABLE_IMAGE_QA_HINT=true

ENABLE_CALCULATOR_TOOL=false
MEMORY_TOP_K=3
MAX_CHAT_TURNS=20

ENABLE_SOURCE_CITATION=true
LOG_LEVEL=INFO
LOG_TO_FILE=true
ENABLE_DOC_PANEL=true
ENABLE_SETTINGS_PANEL=true
ENABLE_HISTORY_PANEL=true
ENABLE_FILE_TOOL=true
ENABLE_SUMMARY_TOOL=true
ENABLE_WEATHER_TOOL=true
ENABLE_WEB_SEARCH=true
ENABLE_ROUTER=true
ENABLE_FALLBACK_ANSWER=true
ENABLE_TOOL_TRACE=true
AGENT_VERBOSE=true
ENABLE_SUMMARY_MEMORY=true
ENABLE_LONG_TERM_MEMORY=false
